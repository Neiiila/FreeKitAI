// Cloudflare Workers deployment config: serves the built site in dist/ as static assets.
// Deployed by the GitHub Actions pipeline with `wrangler deploy`.
{
  "name": "freekitai-v2",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
